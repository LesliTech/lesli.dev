:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
pre,
code {
  font-family: "JetBrains Mono", "Fira Code", source-code-pro, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1.65;
}

pre {
  max-width: 100%;
  overflow-x: auto;
  padding: 1rem 1.2rem;
  border: 1px solid #E5EAF0;
  border-radius: 0.5rem;
  background-color: #F8FAFC;
  white-space: pre;
  tab-size: 4;
  -webkit-overflow-scrolling: touch;
}
pre code {
  font-size: inherit;
  line-height: inherit;
}

.highlight table td {
  padding: 0.3rem;
}

.highlight table pre {
  margin: 0;
}

.highlight,
.highlight .w {
  color: #34404C;
}

.highlight .err {
  color: #8C332F;
  background-color: #FFF4F3;
}

.highlight .c,
.highlight .ch,
.highlight .cd,
.highlight .cm,
.highlight .cpf,
.highlight .c1,
.highlight .cs {
  color: #667383;
}

.highlight .cp,
.highlight .nt,
.highlight .nn,
.highlight .nc,
.highlight .no {
  color: #8A560F;
}

.highlight .o,
.highlight .ow,
.highlight .p,
.highlight .pi {
  color: #667383;
}

.highlight .gi {
  color: #195C43;
}

.highlight .gd {
  color: #8C332F;
}

.highlight .gh {
  color: #194A99;
  background-color: #F2F7FF;
  font-weight: bold;
}

.highlight .k,
.highlight .kn,
.highlight .kp,
.highlight .kr,
.highlight .kv,
.highlight .sa {
  color: #644394;
}

.highlight .kc,
.highlight .kt,
.highlight .kd,
.highlight .m,
.highlight .mb,
.highlight .mf,
.highlight .mh,
.highlight .mi,
.highlight .il,
.highlight .mo,
.highlight .mx {
  color: #834511;
}

.highlight .s,
.highlight .sb,
.highlight .sc,
.highlight .dl,
.highlight .sd,
.highlight .s2,
.highlight .sh,
.highlight .sx,
.highlight .s1,
.highlight .ss {
  color: #195C43;
}

.highlight .sr {
  color: #11586D;
}

.highlight .si,
.highlight .se {
  color: #90314E;
}

.highlight .na {
  color: #11586D;
}
