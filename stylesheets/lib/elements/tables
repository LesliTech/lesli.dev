table {
  width: 100%;
  border-collapse: collapse;
  border-spacing: 0;
}

table.is-fullwidth {
  width: 100%;
}

table th,
table td {
  padding: 0.625rem;
  text-align: left;
  vertical-align: top;
  border: 1px solid #e5eaf0;
}

table th {
  background-color: #f8fafc;
  font-weight: bold;
  text-transform: uppercase;
}

table tbody tr:hover {
  background-color: #f8fafc;
}

@media (max-width: 768px) {
  table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    font-size: 0.75rem;
    -webkit-overflow-scrolling: touch;
  }
  table th, table td {
    padding: 0.5rem;
  }
}
