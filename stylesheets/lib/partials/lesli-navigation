:root {
  --aside-width: 450px;
}

@media only screen and (max-width: 768px) {
  :root {
    --aside-width: 0px;
    --lesli-documentation-padding: 2rem 2rem;
  }
}
@media only screen and (min-width: 769px) {
  :root {
    --aside-width: 200px;
    --lesli-documentation-padding: 10px 5rem 2rem;
  }
}
@media only screen and (min-width: 1024px) {
  :root {
    --aside-width: 350px;
  }
}
@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: 450px;
  }
}
nav.lesli-partial-navigation {
  position: relative;
  z-index: 20;
  display: flex;
  height: 70px;
  flex-grow: 0;
  align-items: center;
  justify-content: flex-end;
  padding: 0.75rem 1rem;
}
nav.lesli-partial-navigation ul {
  display: flex;
  margin: 0;
  padding: 0;
  list-style: none;
}
nav.lesli-partial-navigation .lesli-partial-navigation-logo {
  display: flex;
  align-items: center;
  justify-self: start;
  padding: 0;
}
nav.lesli-partial-navigation .lesli-partial-navigation-logo img {
  height: 30px;
  width: auto;
}
nav.lesli-partial-navigation a {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  padding: 0 1rem;
  border-radius: 0.6rem;
  font-size: 1.05rem;
  font-weight: 400;
  color: #141414;
  transition: color 160ms ease, background-color 160ms ease;
}
nav.lesli-partial-navigation a:hover {
  color: #276AD6;
  background-color: rgba(255, 255, 255, 0.72);
}
nav.lesli-partial-navigation a[aria-current=page] {
  color: #276AD6;
  background-color: rgba(255, 255, 255, 0.82);
  font-weight: 650;
}
nav.lesli-partial-navigation a:focus-visible {
  outline: 3px solid rgba(13, 82, 191, 0.24);
  outline-offset: 2px;
}
nav.lesli-partial-navigation .lesli-partial-navigation-github {
  width: 44px;
  padding: 0;
  justify-self: end;
  font-size: 1.35rem;
}
nav.lesli-partial-navigation .lesli-partial-navigation-mobile,
nav.lesli-partial-navigation .lesli-partial-aside-open {
  display: none;
}
nav.lesli-partial-navigation.lesli-partial-navigation--website {
  display: grid;
  grid-template-columns: minmax(7rem, 1fr) auto minmax(7rem, 1fr);
}
nav.lesli-partial-navigation.lesli-partial-navigation--website .lesli-partial-navigation-links {
  justify-content: center;
}
nav.lesli-partial-navigation.lesli-partial-navigation--documentation {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
}
nav.lesli-partial-navigation.lesli-partial-navigation--documentation .lesli-partial-navigation-logo {
  display: none;
}
nav.lesli-partial-navigation.lesli-partial-navigation--documentation .lesli-partial-navigation-links {
  justify-content: center;
}

@media only screen and (max-width: 768px) {
  nav.lesli-partial-navigation {
    padding: 0.75rem 1rem;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-links {
    display: none;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile {
    position: relative;
    display: block;
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile summary {
    display: grid;
    width: 44px;
    height: 44px;
    border-radius: 0.6rem;
    color: #141414;
    cursor: pointer;
    list-style: none;
    place-items: center;
    font-size: 1.35rem;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile summary::-webkit-details-marker {
    display: none;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile summary:focus-visible {
    outline: 3px solid rgba(13, 82, 191, 0.24);
    outline-offset: 2px;
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile[open] summary {
    color: #276AD6;
    background-color: rgba(255, 255, 255, 0.88);
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile ul {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    display: grid;
    width: min(18rem, 100vw - 2rem);
    padding: 0.5rem;
    border: 1px solid rgba(13, 82, 191, 0.12);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 18px 45px rgba(18, 53, 83, 0.16);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  nav.lesli-partial-navigation .lesli-partial-navigation-mobile a {
    justify-content: flex-start;
    padding: 0.75rem 1rem;
    font-size: 1rem;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--website {
    grid-template-columns: 1fr auto 1fr;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--website .lesli-partial-navigation-logo {
    grid-column: 2;
    grid-row: 1;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--website .lesli-partial-navigation-github {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--documentation {
    grid-template-columns: 1fr auto 1fr;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--documentation .lesli-partial-navigation-logo {
    display: flex;
    grid-column: 2;
    grid-row: 1;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--documentation .lesli-partial-aside-open {
    display: grid;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0.6rem;
    color: #141414;
    background: transparent;
    cursor: pointer;
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    place-items: center;
    font-size: 1.35rem;
  }
  nav.lesli-partial-navigation.lesli-partial-navigation--documentation .lesli-partial-aside-open:focus-visible {
    outline: 3px solid rgba(13, 82, 191, 0.24);
    outline-offset: 2px;
  }
}
