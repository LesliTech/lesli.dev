:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
footer.lesli-footer {
  margin: 0;
  color: rgba(255, 255, 255, 0.78);
  background-color: #0C2856;
}
footer.lesli-footer > .container {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding-top: 4.5rem;
  padding-bottom: 2rem;
  text-align: center;
}
footer.lesli-footer .footer-brand {
  max-width: 36rem;
}
footer.lesli-footer .footer-brand p {
  margin: 1.25rem 0 0;
  color: rgba(255, 255, 255, 0.7);
  font-size: 1.05rem;
  line-height: 1.65;
  text-wrap: balance;
}
footer.lesli-footer .footer-logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0.4rem;
  border-radius: 0.65rem;
}
footer.lesli-footer .footer-logo img {
  width: 100px;
  height: auto;
}
footer.lesli-footer .lesli-footer-navigation {
  margin-top: 2.25rem;
}
footer.lesli-footer .lesli-footer-navigation ul {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.35rem;
  margin: 0;
  padding: 0;
  list-style: none;
}
footer.lesli-footer .lesli-footer-navigation li {
  margin: 0;
  list-style: none;
}
footer.lesli-footer .lesli-footer-navigation a {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  padding: 0.65rem 0.9rem;
  border-radius: 0.65rem;
  color: rgba(255, 255, 255, 0.82);
  font-size: 1rem;
  font-weight: 500;
  transition: color 160ms ease, background-color 160ms ease;
}
footer.lesli-footer .lesli-footer-navigation a:hover {
  color: #ffffff;
  background-color: rgba(255, 255, 255, 0.08);
}
footer.lesli-footer .footer-social {
  display: flex;
  gap: 0.65rem;
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
}
footer.lesli-footer .footer-social li {
  margin: 0;
  list-style: none;
}
footer.lesli-footer .footer-social a {
  display: grid;
  width: 44px;
  height: 44px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 50%;
  color: rgba(255, 255, 255, 0.82);
  place-items: center;
  font-size: 1.3rem;
  transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
}
footer.lesli-footer .footer-social a:hover {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.3);
  background-color: rgba(255, 255, 255, 0.08);
  transform: translateY(-2px);
}
footer.lesli-footer .footer-meta {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
