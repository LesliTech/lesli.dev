:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
section.lesli-component-description {
  background-color: #f9f5f3;
  padding: clamp(6rem, 8vw, 8rem) 0 clamp(7rem, 9vw, 9rem);
}
section.lesli-component-description .columns {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
  margin: 0 auto;
  max-width: 1200px;
}
section.lesli-component-description .column {
  min-width: 0;
  padding: 0;
}
section.lesli-component-description .column a {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: clamp(1.75rem, 3vw, 2.25rem);
  border: 1px solid #C7D0DA;
  border-radius: 1.25rem;
  color: #34404C;
  background-color: #ffffff;
  box-shadow: 0 12px 36px rgba(18, 53, 83, 0.06);
  font-weight: 400;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}
section.lesli-component-description .column a:hover {
  border-color: #8FB5F5;
  box-shadow: 0 18px 42px rgba(18, 53, 83, 0.11);
  transform: translateY(-4px);
}
section.lesli-component-description .column a:focus-visible {
  border-color: #4C83EA;
  outline: 3px solid rgba(13, 82, 191, 0.22);
  outline-offset: 4px;
}
section.lesli-component-description .column a i, section.lesli-component-description .column a h3 {
  color: #4B5663;
}
section.lesli-component-description .column a i {
  display: grid;
  width: 3.75rem;
  height: 3.75rem;
  place-items: center;
  border-radius: 1rem;
  color: #276AD6;
  background-color: #E3EEFF;
  font-size: 2rem;
}
section.lesli-component-description .column a h3 {
  margin: 1.5rem 0 0.6rem;
  font-size: 1.7rem;
  line-height: 1.15;
}
section.lesli-component-description .column a p {
  font-size: 1.1rem;
  line-height: 1.55;
  margin-bottom: 1.5rem;
  color: #4B5663;
}
section.lesli-component-description .column a ul {
  display: grid;
  gap: 0.55rem;
  margin: auto 0 0;
  padding: 1.25rem 0 0;
  border-top: 1px solid #E5EAF0;
}
section.lesli-component-description .column a li {
  display: flex;
  align-items: baseline;
  gap: 0.65rem;
  font-size: 1rem;
  line-height: 1.4;
  list-style: none;
}
section.lesli-component-description .column a li::before {
  flex: 0 0 0.4rem;
  width: 0.4rem;
  height: 0.4rem;
  border-radius: 50%;
  background-color: #4C83EA;
  content: "";
  transform: translateY(-0.1rem);
}

@media only screen and (min-width: 320px) and (max-width: 768px) {
  section.lesli-component-description {
    padding: 5rem 0 6rem;
  }
  section.lesli-component-description .component-header {
    margin-bottom: 3rem;
  }
  section.lesli-component-description .columns {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  section.lesli-component-description .column a {
    padding: 1.5rem;
  }
}
@media (prefers-reduced-motion: reduce) {
  section.lesli-component-description .column a {
    transition: none;
  }
  section.lesli-component-description .column a:hover {
    transform: none;
  }
}
