:root {
  --aside-width: 450px;
}

@media only screen and (max-width: 768px) {
  :root {
    --aside-width: 0px;
    --lesli-documentation-padding: 2rem 2rem;
  }
}
@media only screen and (min-width: 769px) {
  :root {
    --aside-width: 200px;
    --lesli-documentation-padding: 10px 5rem 2rem;
  }
}
@media only screen and (min-width: 1024px) {
  :root {
    --aside-width: 350px;
  }
}
@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: 450px;
  }
}
section.lesli-component-engines {
  padding: clamp(6rem, 8vw, 8rem) 0;
  background-color: #f9f5f3;
}
section.lesli-component-engines .columns {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
}
section.lesli-component-engines .column {
  min-width: 0;
  margin: 0;
  padding: 0;
}
section.lesli-component-engines a {
  display: flex;
  height: 100%;
  align-items: center;
  flex-direction: column;
  padding: 2rem 1.25rem 1.75rem;
  text-align: center;
  border: 1px solid #C7D0DA;
  border-radius: 1.25rem;
  background-color: #ffffff;
  box-shadow: 0 12px 32px rgba(18, 53, 83, 0.07);
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}
section.lesli-component-engines a:hover {
  border-color: #8FB5F5;
  box-shadow: 0 18px 42px rgba(18, 53, 83, 0.12);
  transform: translateY(-4px);
}
section.lesli-component-engines a:focus-visible {
  border-color: #4C83EA;
  outline: 3px solid rgba(13, 82, 191, 0.22);
  outline-offset: 4px;
}
section.lesli-component-engines a .engine-icon {
  display: grid;
  width: 5.25rem;
  height: 5.25rem;
  place-items: center;
  border-radius: 1.5rem;
  background-color: rgba(39, 106, 214, 0.07);
}
section.lesli-component-engines a .engine-icon svg {
  width: 3.75rem;
  height: 3.75rem;
  margin: 0;
  fill: #0C2856;
}
section.lesli-component-engines a h3 {
  margin: 1.25rem auto 0.35rem;
  color: #34404C;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.2;
}
section.lesli-component-engines a p {
  margin: 0;
  color: #4B5663;
  font-size: 1rem;
  line-height: 1.45;
}
section.lesli-component-engines .component-footer {
  margin: 3.5rem 0 0;
}
section.lesli-component-engines .component-footer p {
  max-width: 48rem;
  margin: 0 auto;
  color: #4B5663;
  font-size: 1.15rem;
  line-height: 1.55;
}

@media (max-width: 1000px) {
  section.lesli-component-engines .columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
@media only screen and (min-width: 320px) and (max-width: 768px) {
  section.lesli-component-engines {
    padding: 5rem 0;
  }
  section.lesli-component-engines .component-header {
    margin-bottom: 3rem;
  }
  section.lesli-component-engines .columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }
  section.lesli-component-engines a {
    min-height: 12rem;
    padding: 1.25rem 0.75rem;
  }
  section.lesli-component-engines a .engine-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 1.15rem;
  }
  section.lesli-component-engines a .engine-icon svg {
    width: 2.9rem;
    height: 2.9rem;
  }
  section.lesli-component-engines a h3 {
    margin-top: 1rem;
