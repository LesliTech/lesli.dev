:root {
  --aside-width: 450px;
}

@media only screen and (max-width: 768px) {
  :root {
    --aside-width: 0px;
    --lesli-documentation-padding: 2rem 2rem;
  }
}
@media only screen and (min-width: 769px) {
  :root {
    --aside-width: 200px;
    --lesli-documentation-padding: 10px 5rem 2rem;
  }
}
@media only screen and (min-width: 1024px) {
  :root {
    --aside-width: 350px;
  }
}
@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: 450px;
  }
}
header.catalog-hero {
  display: grid;
  min-height: clamp(27rem, 46vw, 32rem);
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: 70px minmax(0, 1fr);
  padding: 0;
}
header.catalog-hero .catalog-hero-content {
  align-self: center;
  padding: 3.5rem 1rem 4.5rem;
  text-align: center;
}
header.catalog-hero .catalog-hero-eyebrow {
  margin: 0 auto 1rem;
  color: #1F5BBB;
  background: transparent;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.13em;
  line-height: 1.2;
  text-transform: uppercase;
}
header.catalog-hero h1 {
  max-width: 66rem;
  margin: 0 auto 1.25rem;
  color: #34404C;
  background: transparent;
  font-size: clamp(2.65rem, 5vw, 4.25rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.06;
  text-wrap: balance;
}
header.catalog-hero .catalog-hero-summary {
  max-width: 45rem;
  margin: 0 auto;
  color: #4B5663;
  background: transparent;
  font-size: clamp(1.05rem, 1.7vw, 1.25rem);
  line-height: 1.6;
  text-wrap: balance;
}

section.catalog-grid {
  padding: clamp(5rem, 7vw, 7rem) 0;
  background-color: #f9f5f3;
}
section.catalog-grid .catalog-grid-items {
  display: grid;
  grid-auto-rows: 1fr;
  gap: 1rem;
  max-width: 1200px;
  margin: 0 auto;
}
section.catalog-grid.catalog-grid--columns-5 .catalog-grid-items {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}
section.catalog-grid.catalog-grid--columns-4 .catalog-grid-items {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}
section.catalog-grid.catalog-grid--columns-3 .catalog-grid-items {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
section.catalog-grid .catalog-grid-item {
  min-width: 0;
}
section.catalog-grid .catalog-card {
  display: flex;
  min-height: 15rem;
  height: 100%;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: 2rem 1.25rem;
  border: 1px solid #C7D0DA;
  border-radius: 1.25rem;
  color: #34404C;
  background-color: #ffffff;
  box-shadow: 0 12px 32px rgba(18, 53, 83, 0.07);
  text-align: center;
  transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
}
section.catalog-grid .catalog-card:hover {
  border-color: #8FB5F5;
  box-shadow: 0 18px 42px rgba(18, 53, 83, 0.12);
  transform: translateY(-4px);
}
section.catalog-grid .catalog-card:focus-visible {
  border-color: #4C83EA;
  outline: 3px solid rgba(13, 82, 191, 0.22);
  outline-offset: 4px;
}
section.catalog-grid .catalog-card h2 {
  margin: 1.25rem auto 0.45rem;
  color: #34404C;
  font-size: 1.2rem;
  font-weight: 650;
  line-height: 1.25;
}
section.catalog-grid .catalog-card p {
  margin: 0;
  color: #4B5663;
  font-size: 0.95rem;
  line-height: 1.45;
  text-wrap: balance;
}
section.catalog-grid .catalog-card-icon {
  display: grid;
  width: 5rem;
