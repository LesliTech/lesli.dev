:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
section.lesli-component-demo {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding: clamp(6rem, 8vw, 8rem) 0;
  background-color: #276AD6;
  background-image: linear-gradient(145deg, rgba(255, 255, 255, 0.04), rgba(12, 40, 86, 0.12));
}
section.lesli-component-demo::before {
  position: absolute;
  z-index: -1;
  inset: 0;
  opacity: 0.45;
  background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1.25px);
  background-size: 56px 56px;
  content: "";
  pointer-events: none;
}
section.lesli-component-demo .component-header {
  margin-bottom: 3rem;
}
section.lesli-component-demo .component-header h2 {
  color: #ffffff;
}
section.lesli-component-demo .demo-highlights {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem;
  margin: 1.5rem auto 0;
  padding: 0;
  color: #E3EEFF;
  list-style: none;
}
section.lesli-component-demo .demo-highlights li,
section.lesli-component-demo .demo-highlights a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
}
section.lesli-component-demo .demo-highlights li {
  min-height: 2.9rem;
  padding: 0.65rem 0.9rem;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  background-color: rgba(255, 255, 255, 0.08);
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.2;
}
section.lesli-component-demo .demo-highlights a {
  color: inherit;
}
section.lesli-component-demo .demo-highlights a:hover {
  color: #ffffff;
}
section.lesli-component-demo .demo-highlights a:focus-visible {
  border-radius: 0.25rem;
  outline: 3px solid rgba(255, 255, 255, 0.45);
  outline-offset: 3px;
}
section.lesli-component-demo .demo-highlights i {
  font-size: 1.2rem;
}
section.lesli-component-demo lesli-browser {
  display: block;
  width: min(100%, 900px);
  margin: 0 auto;
  border-radius: 0.75rem;
  box-shadow: 0 28px 70px rgba(12, 40, 86, 0.32);
}
section.lesli-component-demo lesli-browser img {
  display: block;
  width: 100%;
  height: auto;
}
section.lesli-component-demo .buttons {
  margin: 2rem auto 0;
}
section.lesli-component-demo .buttons .button-primary-ghost {
  border-color: rgba(255, 255, 255, 0.5);
  color: #194A99;
  background-color: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12px 30px rgba(12, 40, 86, 0.2);
}
section.lesli-component-demo .buttons .button-primary-ghost:hover {
  background-color: #ffffff;
}

@media only screen and (min-width: 320px) and (max-width: 768px) {
  section.lesli-component-demo {
    padding: 5rem 0;
  }
  section.lesli-component-demo .component-header {
    margin-bottom: 2.5rem;
  }
  section.lesli-component-demo .demo-highlights {
    display: grid;
    width: min(100%, 18rem);
    grid-template-columns: 1fr;
    gap: 0.6rem;
  }
  section.lesli-component-demo .demo-highlights li {
    min-height: 2.75rem;
    padding: 0.6rem 0.8rem;
  }
  section.lesli-component-demo lesli-browser {
    width: 100%;
  }
  section.lesli-component-demo .buttons {
    width: min(100%, 22rem);
  }
  section.lesli-component-demo .buttons a {
    width: 100%;
  }
}
