:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
section.lesli-component-structure {
  padding: clamp(6rem, 8vw, 8rem) 0;
  background-color: #ffffff;
}
section.lesli-component-structure > .container {
  width: min(100%, 76rem);
  margin: 0 auto;
}
section.lesli-component-structure .structure-header {
  max-width: 52rem;
  margin: 0 auto;
  text-align: center;
}
section.lesli-component-structure .structure-header h2 {
  margin: 0;
  color: #1F2933;
  font-size: clamp(2.2rem, 4.5vw, 3.5rem);
  line-height: 1.12;
  letter-spacing: -0.03em;
  text-wrap: balance;
}
section.lesli-component-structure .structure-header > p:last-child {
  max-width: 48rem;
  margin: 1.4rem auto 0;
  color: #34404C;
  font-size: 1.12rem;
  line-height: 1.75;
  text-wrap: pretty;
}
section.lesli-component-structure .structure-eyebrow {
  display: inline-flex;
  margin: 0 0 1rem;
  padding: 0.45rem 0.85rem;
  border: 1px solid #C6DCFF;
  border-radius: 999px;
  color: #194A99;
  background-color: #F2F7FF;
  font-size: 0.85rem;
  font-weight: 750;
  letter-spacing: 0.09em;
  line-height: 1.2;
  text-transform: uppercase;
}
section.lesli-component-structure .structure-diagram {
  max-width: 75rem;
  margin: 3rem auto 0;
}
section.lesli-component-structure .structure-diagram img {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid #E3EEFF;
  border-radius: 1.25rem;
  background-color: #F2F7FF;
  box-shadow: 0 1.5rem 4rem rgba(12, 40, 86, 0.1);
}
section.lesli-component-structure .structure-outcomes {
  display: grid;
  max-width: 75rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.25rem auto 0;
}
section.lesli-component-structure .structure-outcome {
  display: grid;
  grid-template-columns: 2.75rem minmax(0, 1fr);
  grid-template-rows: auto auto;
  column-gap: 1rem;
  align-content: start;
  padding: 1.4rem;
  border: 1px solid #E5EAF0;
  border-top-width: 3px;
  border-radius: 1rem;
  background-color: #ffffff;
}
section.lesli-component-structure .structure-outcome > span {
  display: grid;
  width: 2.75rem;
  height: 2.75rem;
  grid-row: 1/3;
  border-radius: 0.75rem;
  place-items: center;
  font-size: 1.25rem;
}
section.lesli-component-structure .structure-outcome h3 {
  margin: 0;
  color: #1F2933;
  font-size: 1.08rem;
  line-height: 1.3;
}
section.lesli-component-structure .structure-outcome p {
  margin: 0.35rem 0 0;
  color: #4B5663;
  line-height: 1.5;
}
section.lesli-component-structure .structure-outcome.structure-outcome--products {
  border-top-color: #276AD6;
}
section.lesli-component-structure .structure-outcome.structure-outcome--products > span {
  color: #194A99;
  background-color: #E3EEFF;
}
section.lesli-component-structure .structure-outcome.structure-outcome--capabilities {
  border-top-color: #22909B;
}
section.lesli-component-structure .structure-outcome.structure-outcome--capabilities > span {
  color: #15636B;
  background-color: #E3F2F4;
}
section.lesli-component-structure .structure-outcome.structure-outcome--ownership {
  border-top-color: #B89D2B;
}
section.lesli-component-structure .structure-outcome.structure-outcome--ownership > span {
  color: #715F14;
  background-color: #F6F2E3;
}

