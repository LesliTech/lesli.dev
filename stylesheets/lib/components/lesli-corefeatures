:root {
  --aside-width: 0px;
  --lesli-documentation-padding: 2rem;
}

@media only screen and (min-width: 1216px) {
  :root {
    --aside-width: clamp(316px, calc(100vw - 900px), 450px);
    --lesli-documentation-padding: 1rem 4rem 2rem;
  }
}
section.lesli-component-corefeatures {
  padding: clamp(6rem, 8vw, 8rem) 0;
}
section.lesli-component-corefeatures .columns {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  grid-auto-rows: 1fr;
  gap: 0.5rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 1rem;
  border: 1px solid #E5EAF0;
  border-radius: 2rem;
  background-color: #f9f5f3;
  box-shadow: 0 18px 50px rgba(18, 53, 83, 0.07);
}
section.lesli-component-corefeatures .column {
  min-width: 0;
  margin: 0;
  padding: 0;
}
section.lesli-component-corefeatures .feature {
  display: grid;
  height: 100%;
  grid-template-columns: 3rem minmax(0, 1fr);
  gap: 1rem;
  padding: 1.35rem;
  border-radius: 1rem;
  background-color: rgba(255, 255, 255, 0.42);
  transition: background-color 160ms ease, transform 160ms ease;
}
section.lesli-component-corefeatures .feature:hover {
  background-color: rgba(255, 255, 255, 0.78);
  transform: translateY(-2px);
}
section.lesli-component-corefeatures .feature i {
  display: grid;
  width: 3rem;
  height: 3rem;
  place-items: center;
  border-radius: 0.9rem;
  background-color: rgba(255, 255, 255, 0.82);
  box-shadow: inset 0 0 0 1px rgba(31, 41, 51, 0.06);
  font-size: 1.65rem;
}
section.lesli-component-corefeatures .feature h3 {
  margin: 0.2rem 0 0.45rem;
  color: #34404C;
  font-size: 1.1rem;
  font-weight: 600;
  line-height: 1.25;
}
section.lesli-component-corefeatures .feature p {
  margin: 0;
  color: #4B5663;
  font-size: 0.95rem;
  font-weight: 400;
  line-height: 1.5;
}
section.lesli-component-corefeatures .column:nth-child(1) .feature i {
  color: #2B88C0;
}
section.lesli-component-corefeatures .column:nth-child(2) .feature i {
  color: #9260DA;
}
section.lesli-component-corefeatures .column:nth-child(3) .feature i {
  color: #C96E20;
}
section.lesli-component-corefeatures .column:nth-child(4) .feature i {
  color: #BE47B8;
}
section.lesli-component-corefeatures .column:nth-child(5) .feature i {
  color: #22909B;
}
section.lesli-component-corefeatures .column:nth-child(6) .feature i {
  color: #B89D2B;
}
section.lesli-component-corefeatures .column:nth-child(7) .feature i {
  color: #D24572;
}
section.lesli-component-corefeatures .column:nth-child(8) .feature i {
  color: #239576;
}
section.lesli-component-corefeatures .column:nth-child(9) .feature i {
  color: #2B88C0;
}
section.lesli-component-corefeatures .column:nth-child(10) .feature i {
  color: #9260DA;
}
section.lesli-component-corefeatures .column:nth-child(11) .feature i {
  color: #C96E20;
}
section.lesli-component-corefeatures .column:nth-child(12) .feature i {
  color: #BE47B8;
}
section.lesli-component-corefeatures .component-footer {
  margin: 3rem 0 0;
}
section.lesli-component-corefeatures .component-footer p {
  margin: 0 auto 1.25rem;
  max-width: 42rem;
  color: #4B5663;
  font-size: 1.1rem;
  line-height: 1.55;
}
section.lesli-component-corefeatures .component-footer .corefeatures-link {
  display: inline-flex;
  min-height: 3.2rem;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.8rem 1.2rem;
