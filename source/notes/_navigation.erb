<%
notes = sitemap.resources
.select { |resource| resource.path.start_with?("notes/") && resource.ext == ".html" }
.reject { |resource| resource.url.start_with?("/index") }
.sort_by { |resource| resource.data.date.to_s }
.reverse
%>
<ul>
    <% notes.each do |note| %>
        <li>
            <a href="<%= note.url %>"><%= note.data.navigation_title || note.data.title %></a>
        </li>
    <% end %>
</ul>
