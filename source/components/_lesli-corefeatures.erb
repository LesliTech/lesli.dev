



<% corefeatures = data.send(I18n.locale.to_sym).component_corefeatures %>

<section class="lesli-component-corefeatures">
    <div class="container">
        <div class="component-header">
            <h2><%= corefeatures[:title] %></h2>
            <p><%= corefeatures[:text] %></p>
        </div>
        <div class="columns">
            <% corefeatures[:content].each do |feature| %>
                <div class="column">
                    <div class="feature">
                        <i class="<%= feature[:icon] %>"></i>
                        <div>
                            <h3>
                                <%= feature[:name] %>
                            </h3>
                            <p><%= feature[:text] %></p>
                        </div>
                    </div>
                </div>
            <% end %>
        </div>
        <div class="component-footer">
            <p><%= corefeatures[:foot] %></p>
            <a class="corefeatures-link" href="/engines/lesli/about/features/">
                Explore all framework features
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </div>
</section>
