<section class="catalog-grid catalog-grid--<%= catalog[:key] %> catalog-grid--columns-<%= catalog[:columns] %>" aria-label="<%= catalog[:label] %>">
    <div class="container">
        <div class="catalog-grid-items">
            <% catalog[:items].each do |item| %>
                <article class="catalog-grid-item">
                    <a class="catalog-card<%= " catalog-card--#{item[:tone]}" if item[:tone] %>" href="<%= item[:href] %>">
                        <span class="catalog-card-icon" aria-hidden="true">
                            <% if item[:svg] %>
                                <%= lesli_svg(item[:svg]) %>
                            <% else %>
                                <i class="<%= item[:icon] %>"></i>
                            <% end %>
                        </span>
                        <h2><%= item[:name] %></h2>
                        <p><%= item[:summary] %></p>
                    </a>
                </article>
            <% end %>
        </div>
    </div>
</section>
