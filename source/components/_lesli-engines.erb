
<% collections = data.send(I18n.locale.to_sym).component_collections %>
<% engines = data.send(I18n.locale.to_sym).catalog_pages[:engines][:items] %>

<% has_header = defined?(header) ? header : true %>

<section class="lesli-component-engines">
    <div class="container">
        <% if has_header %>
            <div class="component-header">
                <h2><%= collections[:title] %></h2>
                <p><%= collections[:text] %></p>
            </div>
        <% end %>
        <div class="columns">
            <% engines.each do |engine| %>
                <div class="column">
                    <a href="<%= engine[:href] %>">
                        <span class="engine-icon" aria-hidden="true">
                            <%= lesli_svg(engine[:svg]) %>
                        </span>
                        <h3><%= engine[:name] %></h3>
                        <p><%= engine[:summary] %></p>
                    </a>
                </div>
            <% end %>
        </div>
        <div class="component-footer">
            <p><%= collections[:foot] %></p>
        </div>
    </div>
</section>
