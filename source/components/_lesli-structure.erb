<section class="lesli-component-structure" id="how-lesli-works">
    <div class="container">
        <div class="structure-header">
            <p class="structure-eyebrow">Lesli in one minute</p>
            <h2>Start with Rails. Add Lesli. Build your product.</h2>
            <p>
                Lesli Core provides the shared foundation. Ready-made modules add common capabilities,
                and custom modules contain the workflows unique to your product.
            </p>
        </div>

        <figure class="structure-diagram">
            <%= image_tag(
                "engines/lesli/structure.excalidraw.svg",
                alt: "Diagram showing a Rails application using Lesli Core and optional modules to become an owned SaaS or business product",
                loading: "lazy"
            ) %>
        </figure>

        <div class="structure-outcomes" aria-label="What Lesli enables">
            <article class="structure-outcome structure-outcome--products">
                <span class="ri-code-s-slash-line" aria-hidden="true"></span>
                <h3>Build real products</h3>
                <p>SaaS platforms, internal tools, customer portals, and workflow systems.</p>
            </article>
            <article class="structure-outcome structure-outcome--capabilities">
                <span class="ri-stack-line" aria-hidden="true"></span>
                <h3>Reuse the essentials</h3>
                <p>Access control, auditing, notifications, administration, and more.</p>
            </article>
            <article class="structure-outcome structure-outcome--ownership">
                <span class="ri-box-3-line" aria-hidden="true"></span>
                <h3>Own the result</h3>
                <p>Your code, data, workflows, integrations, brand, and roadmap stay yours.</p>
            </article>
        </div>
    </div>
</section>
