
<% development = data.send(I18n.locale.to_sym).component_development %>

<section class="lesli-component-development">
    <div class="container">
        <div class="component-header">
            <h2><%= development[:title] %></h2>
            <p><%= development[:text] %></p>
        </div>
        <div class="development-grid">
            <% development[:content].each do |highlight| %>
                <article class="feature">
                    <span class="feature-icon" aria-hidden="true">
                        <i class="<%= highlight[:icon] %>"></i>
                    </span>
                    <h3><%= highlight[:name] %></h3>
                    <p><%= highlight[:text] %></p>
                </article>
            <% end %>
        </div>
        <div class="component-footer">
            <p><%= development[:foot] %></p>
            <a href="/engines/lesli/start/" class="development-action">
                Start building with Lesli
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>
