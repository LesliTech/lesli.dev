---
title: "The Lesli Notes" 
description: "The Lesli developer blog: tutorials, release notes, architecture, and framework updates." 
---
<header class="notes-header">
    <h1>Lesli Notes</h1>
    <p><%= current_page.data.description %></p>
</header>
<section class="notes-container">
    <%
        notes = sitemap.resources
        .select { |resource| resource.path.start_with?("notes/") && resource.ext == ".html" }
        .reject { |resource| resource.url.start_with?("/index") }
        .sort_by { |resource| resource.data.date.to_s }
        .reverse
    %>
    <ul>
        <% notes.each do |note| %>
            <li>
                <a href="<%= note.url %>">
                    <time datetime="<%= note.data.date %>"><%= note.data.date.strftime("%B %-d, %Y") %></time>
                    <h2><%= note.data.title %></h2>
                    <p><%= note.data.description %></p>
                </a>
            </li>
        <% end %>
    </ul>
</section>
