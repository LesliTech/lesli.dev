
<% footer = data.send(I18n.locale.to_sym).partial_footer %>
<% footer_variant = defined?(variant) ? variant.to_s : "website" %>
<% footer_logo = footer_variant == "documentation" ? "brand/lesli.svg" : "brand/lesli-white.svg" %>

<footer class="lesli-footer lesli-footer--<%= footer_variant %>">
    <div class="container">
        <div class="footer-brand">
            <a href="/" class="footer-logo" aria-label="Lesli home">
                <%= image_tag footer_logo, alt: "" %>
            </a>
            <p><%= footer[:tagline] %></p>
        </div>

        <nav class="lesli-footer-navigation" aria-label="Footer navigation">
            <ul>
                <li><a href="/lesli/">Framework</a></li>
                <li><a href="/engines/">Engines</a></li>
                <li><a href="/gems/">Gems</a></li>
                <li><a href="/notes/">Notes</a></li>
                <li><a href="/engines/lesli/start/">Get started</a></li>
            </ul>
        </nav>

        <ul class="footer-social" aria-label="Lesli on social media">
            <li>
                <a href="https://github.com/LesliTech/Lesli" target="_blank" rel="noopener noreferrer" aria-label="Lesli on GitHub">
                    <span class="ri-github-fill" aria-hidden="true"></span>
                </a>
            </li>
            <li>
                <a href="https://www.linkedin.com/company/leslitech/" target="_blank" rel="noopener noreferrer" aria-label="Lesli Technologies on LinkedIn">
                    <span class="ri-linkedin-fill" aria-hidden="true"></span>
                </a>
            </li>
        </ul>

        <div class="footer-meta">
            <p>&copy; <%= Time.now.year %> <a href="https://www.lesli.tech/" target="_blank" rel="noopener noreferrer">Lesli Technologies</a>.</p>
            <span aria-hidden="true">&middot;</span>
            <p><%= footer[:license] %></p>
        </div>
    </div>
</footer>
