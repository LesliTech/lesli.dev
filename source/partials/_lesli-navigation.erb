
<% has_logo = logo %>
<% active_section = defined?(active) ? active.to_s : nil %>
<% navigation_links = [{ key: "framework", href: "/lesli/", text: "Framework" }, { key: "engines", href: "/engines/", text: "Engines" }, { key: "gems", href: "/gems/", text: "Gems" }, { key: "notes", href: "/notes/", text: "Notes" }] %>
<% unless has_logo %>
    <script>
        function openAside(button) {
            const el = document.getElementById("lesli-partial-aside");
            if (!el) return;

            el.classList.add("open");
            button.setAttribute("aria-expanded", "true");
        }
    </script>
<% end %>
<nav class="lesli-partial-navigation container<%= " lesli-partial-navigation--website" if has_logo %>" aria-label="Primary navigation">
    <% if has_logo %>
        <a class="lesli-partial-navigation-logo" href="/" aria-label="Lesli home">
            <%= image_tag "brand/lesli.svg", alt: "" %>
        </a>
    <% end %>
    <ul class="lesli-partial-navigation-links">
        <% navigation_links.each do |item| %>
            <li>
                <a href="<%= item[:href] %>"<%= ' aria-current="page"' if active_section == item[:key] %>><%= item[:text] %></a>
            </li>
        <% end %>
    </ul>

    <% if has_logo %>
        <a class="lesli-partial-navigation-github" href="https://github.com/LesliTech/Lesli" target="_blank" rel="noopener noreferrer" aria-label="Lesli on GitHub">
            <span class="ri-github-fill" aria-hidden="true"></span>
        </a>

        <details class="lesli-partial-navigation-mobile">
            <summary aria-label="Toggle navigation">
                <span class="ri-menu-3-line" aria-hidden="true"></span>
            </summary>
            <ul>
                <% navigation_links.each do |item| %>
                    <li>
                        <a href="<%= item[:href] %>"<%= ' aria-current="page"' if active_section == item[:key] %>><%= item[:text] %></a>
                    </li>
                <% end %>
            </ul>
        </details>
    <% else %>
        <button class="lesli-partial-aside-open" type="button" aria-label="Open section navigation" aria-controls="lesli-partial-aside" aria-expanded="false" onclick="openAside(this)">
            <span class="ri-menu-3-line" aria-hidden="true"></span>
        </button>
    <% end %>
</nav>
